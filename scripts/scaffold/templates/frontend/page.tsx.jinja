import { useCallback, useEffect, useState } from 'react';
import { useToast } from '@/context/ToastContext';
import { useConfirm } from '@/lib/hooks/useConfirm';
{% if is_scoped %}
import { << singular >>Service, userService } from '@/lib/api/services';
{% else %}
import { << singular >>Service } from '@/lib/api/services';
{% endif %}
{% if enum_consts %}
import {
{% for c in enum_consts %}
  << c.options >>,
{% if c.filterable %}
  << c.filter >>,
{% endif %}
{% endfor %}
} from '@/lib/constants';
{% endif %}
import DashboardLayout from '@/components/layout/DashboardLayout';
import Card from '@/components/common/Card';
import Table from '@/components/common/Table';
import Modal from '@/components/common/Modal';
import Input from '@/components/common/Input';
import Button from '@/components/common/Button';
import ProtectedComponent from '@/components/common/ProtectedComponent';
{% if filter_enum_fields %}
import FilterSelect from '@/components/common/FilterSelect';
{% endif %}
import Pagination from '@/components/common/Pagination';
import ErrorAlert from '@/components/common/ErrorAlert';
import ModalFooter from '@/components/common/ModalFooter';
{% if is_scoped %}
import { useAuth } from '@/context/AuthContext';
{% endif %}
import { << S >>, Create<< S >>DTO, TableColumn, TableAction{% if is_scoped %}, UserScope{% endif %} } from '@/types';
import { << icon >> as ResourceIcon, Pencil, Trash2{% if is_scoped %}, Filter{% endif %} } from 'lucide-react';

const emptyForm: Create<< S >>DTO = << empty_form_src >>;

export default function << PluralPascal >>Page() {
{% if is_scoped %}
  const { user } = useAuth();
{% endif %}
  const { success, error: showError } = useToast();
  const { confirm, ConfirmationDialog } = useConfirm();

  const [items, setItems] = useState<< '<' + S >>[]>([]);
  const [total, setTotal] = useState(0);
  const [pages, setPages] = useState(1);
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);
  const [isLoading, setIsLoading] = useState(true);
{% for f in filter_enum_fields %}
  const [<< f.name >>Filter, set<< f.name|capitalize >>Filter] = useState('all');
{% endfor %}
{% if is_scoped %}
  const [myScopes, setMyScopes] = useState<UserScope[]>([]);
{% endif %}

  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editing, setEditing] = useState<< '<' + S >> | null>(null);
  const [formData, setFormData] = useState<Create<< S >>DTO>(emptyForm);
  const [formError, setFormError] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);

  const load = useCallback(async (currentPage: number, size: number) => {
    setIsLoading(true);
    try {
      const res = await << singular >>Service.getAll({
        page: currentPage,
        size,
{% for f in filter_enum_fields %}
        ...(<< f.name >>Filter !== 'all' && { << f.name >>: << f.name >>Filter }),
{% endfor %}
      });
      setItems(res.items);
      setTotal(res.total);
      setPages(res.pages || 1);
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Error al cargar << label_plural >>');
    } finally {
      setIsLoading(false);
    }
{% if filter_enum_fields %}
  }, [{% for f in filter_enum_fields %}<< f.name >>Filter, {% endfor %}showError]);
{% else %}
  }, [showError]);
{% endif %}

{% if filter_enum_fields %}
  useEffect(() => { setPage(1); }, [{% for f in filter_enum_fields %}<< f.name >>Filter, {% endfor %}pageSize]);
{% else %}
  useEffect(() => { setPage(1); }, [pageSize]);
{% endif %}
  useEffect(() => { load(page, pageSize); }, [load, page, pageSize]);
{% if is_scoped %}

  useEffect(() => {
    userService.getMyScopes().then((r) => setMyScopes(r.items)).catch(() => setMyScopes([]));
  }, []);
{% endif %}

  const openCreate = () => {
    setEditing(null);
    setFormData(emptyForm);
    setFormError('');
    setIsModalOpen(true);
  };

  const openEdit = (item: << S >>) => {
    setEditing(item);
    setFormData({ << form_pick_src >> });
    setFormError('');
    setIsModalOpen(true);
  };

  const handleDelete = async (item: << S >>) => {
    const confirmed = await confirm({
      title: 'Eliminar << label_singular >>',
      message: `¿Eliminar el registro #${item.id}?`,
      confirmText: 'Eliminar',
      cancelText: 'Cancelar',
      variant: 'danger',
    });
    if (!confirmed) return;
    try {
      await << singular >>Service.delete(item.id);
      success(`<< label_singular >> #${item.id} eliminado`);
      await load(page, pageSize);
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Error al eliminar');
    }
  };

  const handleSubmit = async () => {
    setFormError('');
{% if required_check_src %}
    << required_check_src >>
{% endif %}
    setIsSubmitting(true);
    try {
      if (editing) {
        await << singular >>Service.update(editing.id, formData);
        success('<< label_singular >> actualizado');
      } else {
        await << singular >>Service.create(formData);
        success('<< label_singular >> creado');
      }
      setIsModalOpen(false);
      await load(page, pageSize);
    } catch (err) {
      setFormError(err instanceof Error ? err.message : 'Error al guardar');
    } finally {
      setIsSubmitting(false);
    }
  };

  const startIndex = total === 0 ? 0 : (page - 1) * pageSize + 1;
  const endIndex = Math.min(page * pageSize, total);

  const columns: TableColumn<< '<' + S >>>[] = [
    << columns_src | indent(4) >>
  ];

  const actions: TableAction<< '<' + S >>>[] = [
    { label: 'Editar', onClick: openEdit, variant: 'secondary', permission: '<< plural >>:update', icon: <Pencil className="w-3 h-3" /> },
    { label: 'Eliminar', onClick: handleDelete, variant: 'danger', permission: '<< plural >>:delete', icon: <Trash2 className="w-3 h-3" /> },
  ];

  return (
    <DashboardLayout title="<< label_plural >>">
      <div className="space-y-4">
{% if is_scoped %}
        <div className="rounded-lg border border-blue-200 dark:border-blue-900/60 bg-blue-50/60 dark:bg-blue-950/20 px-4 py-3 flex items-start gap-2.5">
          <Filter className="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
          <div className="text-xs text-blue-800 dark:text-blue-300">
            <p>Esta lista ya viene <strong>filtrada por tu alcance</strong> según los permisos de tus roles.</p>
            {myScopes.length > 0 && (
              <p className="mt-1">
                Tus alcances:{' '}
                {myScopes.map((s, i) => (
                  <span key={i} className="font-mono">{s.dimension}={s.value}{i < myScopes.length - 1 ? ', ' : ''}</span>
                ))}
              </p>
            )}
          </div>
        </div>
{% endif %}

        <Card
          title={`<< label_plural >> (${total})`}
          actions={
            <ProtectedComponent permissions={['<< plural >>:create']}>
              <Button onClick={openCreate} className="flex items-center gap-2">
                <ResourceIcon className="w-4 h-4" />
                Nuevo
              </Button>
            </ProtectedComponent>
          }
        >
{% if filter_enum_fields %}
          <div className="mb-5 flex flex-wrap gap-4">
{% for f in filter_enum_fields %}
            <FilterSelect
              label="<< f.name|capitalize >>"
              value={<< f.name >>Filter}
              onChange={set<< f.name|capitalize >>Filter}
              options={<< plural|upper >>_<< f.name|upper >>_FILTER_OPTIONS}
            />
{% endfor %}
          </div>
{% endif %}

          <Table data={items} columns={columns} actions={actions} isLoading={isLoading} emptyMessage="Sin registros" />

          {pages > 0 && (
            <Pagination
              currentPage={page}
              totalPages={pages}
              onPageChange={setPage}
              onFirstPage={() => setPage(1)}
              onLastPage={() => setPage(pages)}
              onPreviousPage={() => setPage((p) => Math.max(1, p - 1))}
              onNextPage={() => setPage((p) => Math.min(pages, p + 1))}
              startIndex={startIndex}
              endIndex={endIndex}
              totalItems={total}
              itemsPerPage={pageSize}
              onItemsPerPageChange={setPageSize}
            />
          )}
        </Card>
      </div>

      <Modal
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        title={editing ? `Editar << label_singular >> #${editing.id}` : 'Nuevo << label_singular >>'}
        footer={
          <ModalFooter
            onCancel={() => setIsModalOpen(false)}
            onSubmit={handleSubmit}
            isSubmitting={isSubmitting}
            isEditing={!!editing}
          />
        }
      >
        <div className="space-y-4">
          <ErrorAlert message={formError} />
          << form_body_src | indent(10) >>
        </div>
      </Modal>

      <ConfirmationDialog />
    </DashboardLayout>
  );
}
