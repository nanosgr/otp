def test_crud_happy_path(client, graph):
    r = client.post("/api/v1/<< plural >>/", headers=_token(graph["admin"]), json=CREATE_PAYLOAD)
    assert r.status_code == 200, r.text
    obj_id = r.json()["id"]

    assert client.get(f"/api/v1/<< plural >>/{obj_id}", headers=_token(graph["admin"])).status_code == 200

    r = client.get("/api/v1/<< plural >>/", headers=_token(graph["admin"]))
    assert r.status_code == 200
    assert r.json()["total"] >= 1

    r = client.put(f"/api/v1/<< plural >>/{obj_id}", headers=_token(graph["admin"]), json=UPDATE_PAYLOAD)
    assert r.status_code == 200, r.text

    assert client.delete(f"/api/v1/<< plural >>/{obj_id}", headers=_token(graph["admin"])).status_code == 200
    assert client.get(f"/api/v1/<< plural >>/{obj_id}", headers=_token(graph["admin"])).status_code == 404


