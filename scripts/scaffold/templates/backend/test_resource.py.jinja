def test_attribute_scope_filters_by_dimension(client, graph, db):
    # fila dentro de la dimensión del boss
    inside = dict(CREATE_PAYLOAD)
    inside["<< dimension >>"] = << dim_value | repr >>
    outside = dict(CREATE_PAYLOAD)
    outside["<< dimension >>"] = "otra-dimension"
    a = client.post("/api/v1/<< plural >>/", headers=_token(graph["admin"]), json=inside)
    b = client.post("/api/v1/<< plural >>/", headers=_token(graph["admin"]), json=outside)
    assert a.status_code == 200 and b.status_code == 200, (a.text, b.text)

    body = client.get("/api/v1/<< plural >>/", headers=_token(graph["boss"])).json()
    ids = {it["id"] for it in body["items"]}
    assert a.json()["id"] in ids
    assert b.json()["id"] not in ids
