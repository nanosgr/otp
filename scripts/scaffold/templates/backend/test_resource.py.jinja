def test_own_scope_lists_only_own_rows(client, graph, db):
    r1 = client.post("/api/v1/<< plural >>/", headers=_token(graph["seller"]), json=CREATE_PAYLOAD)
    assert r1.status_code == 200, r1.text
    assert r1.json()["owner_id"] == graph["seller"].id
    client.post("/api/v1/<< plural >>/", headers=_token(graph["seller2"]), json=CREATE_PAYLOAD)

    body = client.get("/api/v1/<< plural >>/", headers=_token(graph["seller"])).json()
    assert body["total"] == 1
    assert {it["owner_id"] for it in body["items"]} == {graph["seller"].id}

    # el admin (*:*) ve todo
    assert client.get("/api/v1/<< plural >>/", headers=_token(graph["admin"])).json()["total"] == 2


def test_own_scope_out_of_scope_row_is_404(client, graph):
    other = client.post("/api/v1/<< plural >>/", headers=_token(graph["seller2"]), json=CREATE_PAYLOAD).json()
    assert client.get(f"/api/v1/<< plural >>/{other['id']}", headers=_token(graph["seller"])).status_code == 404
